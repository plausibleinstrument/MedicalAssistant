# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is SECRET - server-side only, never exposed to the browser.
# Used for admin actions like verifying invite codes before a profile exists.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for the doctor-visit prep agent and document auto-classification
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-5 in code
ANTHROPIC_MODEL=claude-sonnet-5

# The site URL, used for OAuth redirects. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
